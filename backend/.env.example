APP_NAME=Sports Fanatics API
# JSON array; extend when deploying the frontend on another origin.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://fanatics:local-development-only@localhost:5432/fanatics
FIREBASE_PROJECT_ID=sports-fanatics-local
# Local development only. Never set this in a production environment.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
SOLVER_TIMEOUT_SECONDS=2
WORKER_INTERVAL_SECONDS=1

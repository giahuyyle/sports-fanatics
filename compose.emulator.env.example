# Copy to .env.emulator; run:
# docker compose --env-file .env.emulator --profile emulator up --build
FIREBASE_PROJECT_ID=demo-sports-fanatics
FIREBASE_WEB_API_KEY=demo-key
FIREBASE_AUTH_DOMAIN=localhost
FIREBASE_CREDENTIALS_DIR=./.secrets
# Container address for FastAPI; browser address for Firebase Web SDK.
FIREBASE_AUTH_EMULATOR_HOST=auth:9099
FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
DATABASE_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173
AUTH_PORT=9099

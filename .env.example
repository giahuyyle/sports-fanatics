# Docker Compose reads this root .env. Native tools still use backend/frontend .env.
# Copy to .env, then fill these public identifiers from Firebase Project settings.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Directory containing firebase-admin.json. Server-only; never put it in frontend/.
FIREBASE_CREDENTIALS_DIR=./.secrets
# Leave both empty for your real Firebase project.
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_URL=

DATABASE_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173
AUTH_PORT=9099
SOLVER_TIMEOUT_SECONDS=2
WORKER_INTERVAL_SECONDS=1

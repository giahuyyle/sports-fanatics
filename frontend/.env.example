# Development proxy destination (used by Vite, not exposed to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000
# Leave empty to use same-origin /api requests. Set for a separately hosted API.
VITE_API_BASE_URL=
# Firebase web configuration (public identifiers; never use service account keys here).
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Development-only emulator; ignored in production builds.
VITE_FIREBASE_AUTH_EMULATOR_URL=
